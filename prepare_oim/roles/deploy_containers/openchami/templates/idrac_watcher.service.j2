[Unit]
Description=Omnia iDRAC DHCP lease watcher
After=coresmd-coredhcp.service
Wants=coresmd-coredhcp.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/omnia/utils/idrac_watcher.py --config /opt/omnia/openchami/idrac_watcher_config.json
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=idrac-watcher
ExecStopPost=/bin/sh -c 'rm -f /opt/omnia/openchami/idrac_dense_inventory.json'

[Install]
WantedBy=multi-user.target
